#!/usr/bin/env bash
# Starts the DreamyOS desktop (Hyprland) and explains what to do if it fails.
#
# If the desktop crashes within a few seconds, it is started again once with
# software rendering (no 3D acceleration needed). That helps in virtual machines.

CACHE="$HOME/.cache/dreamyos"
mkdir -p "$CACHE"
LOG="$CACHE/hyprland.log"
EXIT_MARKER="$CACHE/user-exit"   # written by dreamy-logout when YOU choose to leave

# Tell the Hyprland config if we are in a virtual machine, so it can turn off heavy effects.
virt="$(systemd-detect-virt 2>/dev/null || true)"
if [[ -n "$virt" && "$virt" != "none" ]]; then
    export DREAMY_VM=1
fi

run_hyprland() {
    rm -f "$EXIT_MARKER"
    local start=$SECONDS
    if command -v start-hyprland >/dev/null 2>&1; then
        start-hyprland >"$LOG" 2>&1
    else
        Hyprland >"$LOG" 2>&1
    fi
    last_status=$?
    last_runtime=$((SECONDS - start))
    # Keep a copy of Hyprland's own detailed log too.
    local hlog
    hlog="$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$UID}"/hypr/*/hyprland.log 2>/dev/null | head -n 1)"
    [[ -n "$hlog" ]] && cp -f "$hlog" "$CACHE/hyprland-full.log"
}

use_software_rendering() {
    export DREAMY_SOFTWARE_RENDERING=1
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe
}

[[ -e "$CACHE/use-software-rendering" ]] && use_software_rendering

echo "Starting the DreamyOS desktop..."
run_hyprland

# Crashed quickly (and you didn't log out)? Try once more with software rendering.
if [[ ! -e "$EXIT_MARKER" && $last_runtime -lt 30 && -z "${DREAMY_SOFTWARE_RENDERING:-}" ]]; then
    cp -f "$LOG" "$CACHE/hyprland-first-try.log"
    echo "The desktop stopped right away. Trying again with software rendering..."
    sleep 1
    use_software_rendering
    run_hyprland
    if [[ ! -e "$EXIT_MARKER" && $last_runtime -lt 30 ]]; then
        : # still failing, fall through to the error message below
    else
        touch "$CACHE/use-software-rendering"   # remember what worked for this session
    fi
fi

clear
if [[ -e "$EXIT_MARKER" ]]; then
    echo
    echo "  You left the DreamyOS desktop."
    echo
    echo "  To go back, type:   dreamy-session"
    echo "  To shut down, type: poweroff"
    echo
else
    echo
    echo "  The DreamyOS desktop stopped unexpectedly (code $last_status, after ${last_runtime}s)."
    echo
    echo "  If you are using VirtualBox, try this:"
    echo "    1. Shut down the VM (type: poweroff)"
    echo "    2. Settings > Display > Graphics Controller: VMSVGA, Video Memory: 128 MB"
    echo "    3. Turn 'Enable 3D Acceleration' off (or on, if it was off)"
    echo "    4. Start the VM again"
    echo
    echo "  To try again now, type: dreamy-session"
    echo "  Logs: $CACHE/"
    echo "  Last lines of the log:"
    echo "  ----------------------------------------"
    grep -iE 'err|fail|crit|fatal|abort' "$LOG" "$CACHE/hyprland-full.log" 2>/dev/null | tail -n 12 | cut -c1-150 | sed 's/^/  /'
    echo
fi
